{
  "rewrites": [
    {
      "source": "/m/:slug",
      "destination": "/api/m/:slug"
    },
    {
      "source": "/hosts",
      "destination": "/api/hosts"
    },
    {
      "source": "/join",
      "destination": "/api/join"
    }
  ],
  "functions": {
    "api/[route].js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/instagram-sync",
      "schedule": "0 22 * * *"
    }
  ]
}
