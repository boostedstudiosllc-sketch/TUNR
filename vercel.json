{
  "rewrites": [
    {
      "source": "/m/:slug",
      "destination": "/api/m/:slug"
    },
    {
      "source": "/hosts",
      "destination": "/api/hosts"
    },
    {
      "source": "/join",
      "destination": "/api/join"
    }
  ],
  "functions": {
    "api/read-flyer.js": {
      "maxDuration": 60
    },
    "api/reminders.js": {
      "maxDuration": 60
    },
    "api/push.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
